{
  "name": "@wtfalch/audit",
  "version": "0.11.0",
  "description": "The estate's append-only audit ledger: the table's shape and walls, erasure, export, readers and a cross-app read handler, with a signer a host builds once inside its trusted base and never exports. Per-app Postgres, a host-supplied vocabulary of closed sets, no framework.",
  "repository": {
    "type": "git",
    "url": "https://github.com/wtfalch/audit",
    "directory": "packages/audit"
  },
  "license": "MIT",
  "type": "module",
  "files": ["dist"],
  "bin": {
    "audit-migrations": "dist/bin/migrations.js",
    "audit-verify-chain": "dist/bin/verify-chain.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./read": {
      "types": "./dist/read/index.d.ts",
      "default": "./dist/read/index.js"
    },
    "./migrations-dir": {
      "types": "./dist/migrations-dir.d.ts",
      "default": "./dist/migrations-dir.js"
    },
    "./migrations/*.sql": "./dist/migrations/*.sql",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && mkdir -p dist/migrations && cp src/migrations/*.sql dist/migrations/",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@wtfalch/authz": "^0.16.0",
    "@wtfalch/contracts": "^0.2.0",
    "@wtfalch/design": "^0.30.0",
    "@wtfalch/db": ">=0.5.2 <0.6.0",
    "drizzle-orm": ">=0.39.3 <1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@wtfalch/db": {
      "optional": true
    },
    "@wtfalch/contracts": {
      "optional": true
    },
    "@wtfalch/design": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@wtfalch/authz": "0.16.0",
    "@wtfalch/contracts": "0.2.0",
    "@wtfalch/db": "0.5.2",
    "@wtfalch/design": "0.30.0",
    "drizzle-orm": "0.39.3",
    "jsdom": "^30.0.1",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5.9.0",
    "vitest": "^4.1.6",
    "zod": "^4.5.4"
  }
}
